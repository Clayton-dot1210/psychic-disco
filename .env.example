# Anthropic API key — required for /api/generate, /api/learn/explain, /api/learn/path
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheets integration — required for /api/automate/batch-sheet
# Path to your Google service account JSON key file
GOOGLE_CREDENTIALS_PATH=/path/to/service-account-key.json

# Nano Banana webhook — required for /api/automate/nano-banana
NANO_BANANA_WEBHOOK_URL=https://your-nano-banana-webhook-url.com/hook/xxx
